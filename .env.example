APP_NAME="PDF Storage"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Docker ------------------------------------------------------------------
# Host ports. Change them if something on your machine already uses them.
APP_PORT=8080
FORWARD_DB_PORT=3306
FORWARD_RABBITMQ_PORT=5672
FORWARD_RABBITMQ_UI_PORT=15672
FORWARD_MAILPIT_UI_PORT=8025
FORWARD_MAILPIT_SMTP_PORT=1025

# --- Database (MySQL container) ----------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=pdf_storage
DB_USERNAME=app
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CACHE_STORE=database

# --- Queue (RabbitMQ container) ----------------------------------------------
QUEUE_CONNECTION=rabbitmq
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=app
RABBITMQ_PASSWORD=secret
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=notifications

# --- Mail (Mailpit container, UI at http://localhost:8025) --------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@pdf-storage.local"
MAIL_FROM_NAME="${APP_NAME}"

# --- File storage --------------------------------------------------------------
# Deletion notifications (manual and automatic) are sent to this address.
NOTIFICATION_EMAIL=admin@example.com
NOTIFICATION_QUEUE_CONNECTION=rabbitmq
NOTIFICATION_QUEUE=notifications
FILE_STORAGE_DISK=local
FILE_MAX_SIZE_KB=10240
FILE_TTL_HOURS=24
